{
  "manifest_version": 3,
  "name": "토인비 조판",
  "version": "0.1.0",
  "description": "인디자인 내지(IDML)를 올리면 구글 독스 원고의 조판 미리보기를 문서 오른쪽에 나란히 띄웁니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*"
  ],
  "action": {
    "default_title": "토인비 조판 미리보기 열기/닫기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "조판 미리보기 열기/닫기"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/page-bridge.js"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "lib/zip.js",
        "lib/idml.js",
        "lib/docs-source.js",
        "lib/style-css.js",
        "lib/defaults.js",
        "lib/layout.js",
        "lib/markup.js",
        "lib/fonts.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
